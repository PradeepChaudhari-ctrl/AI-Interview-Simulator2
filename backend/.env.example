APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///./ai_interview.db
# For PostgreSQL in production or local:
# DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/ai_interview
GEMINI_API_KEY=
# Add up to three more numbered keys, or put all keys in GEMINI_API_KEYS below.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
# Optional comma-separated list; additional unique entries are also rotated.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.7-flash
GEMINI_RPM_LIMIT=5
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
MAX_UPLOAD_MB=10
UPLOAD_DIR=./uploads

CONTEXT_DEV_API_KEY=
CONTEXT_DEV_MODE=fast
